# Every setting the dogfood server reads, with placeholder values.
# docker-compose.yml sets the ones a demo needs; copy what you change there
# (or into your own environment). Nothing here is required for a demo.

# Where the API listens and where its SQLite file lives.
DOGFOOD_ADDR=:8080
DOGFOOD_DB=/data/dogfood.db
DOGFOOD_FIXTURES=/app/fixtures.json

# 1 installs known demo passwords and API tokens. Set 0 for a real event.
DOGFOOD_DEMO=1

# The Next.js frontend the API proxies page requests to.
DOGFOOD_FRONTEND_URL=http://web:3000

# Behind HTTPS or your own reverse proxy.
DOGFOOD_PUBLIC_URL=https://judge.example.org
DOGFOOD_SECURE_COOKIES=0
DOGFOOD_TRUST_PROXY=0

# Optional sign-in providers. Each is enabled only when both values are set;
# with none set the portal makes no outbound request. Register this redirect
# URI with each provider: ${DOGFOOD_PUBLIC_URL}/api/v1/auth/<provider>/callback
DOGFOOD_OAUTH_GITHUB_CLIENT_ID=your_github_client_id
DOGFOOD_OAUTH_GITHUB_CLIENT_SECRET=your_github_client_secret
DOGFOOD_OAUTH_GOOGLE_CLIENT_ID=your_google_client_id
DOGFOOD_OAUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret
DOGFOOD_OAUTH_LINKEDIN_CLIENT_ID=your_linkedin_client_id
DOGFOOD_OAUTH_LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
DOGFOOD_OAUTH_X_CLIENT_ID=your_x_client_id
DOGFOOD_OAUTH_X_CLIENT_SECRET=your_x_client_secret
