{
  "name": "dogfood-judge-video",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion source for the Dogfood Judge hackathon submission video",
  "scripts": {
    "voice": "python scripts/generate_voice.py",
    "dev": "remotion studio",
    "render": "remotion render DogfoodJudge out/dogfood-judge.mp4",
    "render:draft": "remotion render DogfoodJudge out/dogfood-judge-draft.mp4 --scale=0.5 --crf=28",
    "still": "remotion still DogfoodJudge out/frame.png --frame=60",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.531",
    "@remotion/google-fonts": "^4.0.531",
    "@remotion/media-utils": "^4.0.531",
    "@remotion/transitions": "^4.0.531",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.531"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
